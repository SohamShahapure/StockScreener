CORS_ORIGINS=["http://localhost:3000"]
CACHE_TTL_SECONDS=300
DEFAULT_HISTORY_PERIOD=1y
DATABASE_URL=sqlite:///./stock_screener.db
DB_CACHE_TTL_SECONDS=1800

# Free key from https://newsapi.org - sign up, verify email, copy the key here.
NEWS_API_KEY=
NEWS_CACHE_TTL_SECONDS=1800

# Reddit (PRAW) - free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-screener-app by u/yourusername
REDDIT_SUBREDDITS=stocks,wallstreetbits,investing

# StockTwits needs no key - public endpoint.
SOCIAL_CACHE_TTL_SECONDS=900

# Phase 9: RAG knowledge base. Model downloads once (~90MB) from Hugging
# Face on first use, then caches locally - needs internet for that one-time
# download only.
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
KB_COLLECTION_NAME=financial_knowledge_base

# Phase 10/11: AI investment insight generation.
# LLM_PROVIDER: "groq" (hosted, very fast, free tier - recommended),
# "anthropic" (Claude), or "ollama" (fully local, no API key).
LLM_PROVIDER=groq
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
